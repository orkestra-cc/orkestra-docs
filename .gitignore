# Dependencies
/node_modules

# Production
/build

# Generated files
.docusaurus
.cache-loader

# Synced content — every page under docs/ is regenerated at build time by
# `npm run sync` (see sources.yaml + .github/workflows/build.yml). This repo
# is a pure renderer; no hand-written content lives here. .gitkeep preserves
# the directory itself so a fresh clone has somewhere for sync to land.
/static/openapi/
/docs/*
!/docs/.gitkeep

# Misc
.DS_Store
.env.local
.env.development.local
.env.test.local
.env.production.local

npm-debug.log*
yarn-debug.log*
yarn-error.log*
