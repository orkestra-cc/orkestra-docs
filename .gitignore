# Dependencies
/node_modules

# Production
/build

# Generated files
.docusaurus
.cache-loader

# Synced content — regenerated by `npm run sync:*` and via CI in
# .github/workflows/build.yml + sync-nightly.yml.
/static/openapi/
/docs/api/reference/
# Module addon pages are pulled from each addon repo's README at build time.
# The folder is tracked via _category_.json + index.mdx; everything else is synced.
/docs/modules/addons/*
!/docs/modules/addons/_category_.json
!/docs/modules/addons/index.mdx
# ADRs synced from monorepo opt-in (frontmatter `public: true`).
/docs/adrs/*
!/docs/adrs/index.mdx

# Misc
.DS_Store
.env.local
.env.development.local
.env.test.local
.env.production.local

npm-debug.log*
yarn-debug.log*
yarn-error.log*
